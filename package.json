{
  "name": "@foxxmd/circuit-breaker-proxy",
  "version": "2.0.0",
  "type": "module",
  "description": "Node.js proxy for clients with circuit breaker. Allows providing a set of clients and round-robin function calls against them with circuit breaker logic.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "nyc --reporter=html mocha",
    "build": "tsc",
    "prepare": "tshy"
  },
  "author": "ceecko",
  "license": "MIT",
  "tshy": {
    "project": "./tsconfig.build.json",
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.js"
    },
    "dialects": [
      "esm"
    ]
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "cockatiel": "^3.2.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^21.1.2",
    "tshy": "^4.1.3",
    "typescript": "^6.0.3"
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceecko/circuit-breaker-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/ceecko/circuit-breaker-proxy/issues"
  },
  "homepage": "https://github.com/ceecko/circuit-breaker-proxy#readme",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    }
  },
  "module": "./dist/esm/index.js"
}
